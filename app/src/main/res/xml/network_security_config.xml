<?xml version="1.0" encoding="utf-8"?>
<!--
  Release policy: no cleartext traffic anywhere. All HTTP(S)/WS(S) and SIP
  traffic must be encrypted (SIP over TLS is negotiated by the engine).
  Debug builds override this file to permit cleartext against a local server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
