# Copy to server/.env and replace every placeholder before starting Compose.
# Never commit server/.env. Use a unique password-manager-generated passphrase.
ADMIN_USERNAME=operator
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
PBX_AMI_PASSWORD=
# PostgreSQL superuser password for the compose db service and the API
# (ADR-0008). Mandatory: the API refuses to start without it.
DB_PASSWORD=
# Optional overrides (defaults shown): DB_NAME=stringtelephone
# DB_USER=stringtelephone DB_HOST=localhost DB_PORT=5432

# Garage S3-compatible object storage (ADR-0009)
ST_MEDIA_ENABLED=true
ST_MEDIA_BUCKET=garage
ST_MEDIA_ENDPOINT=http://garage:3900
ST_MEDIA_REGION=garage
ST_MEDIA_ACCESS_KEY=
ST_MEDIA_SECRET_KEY=
# Garage refuses to start without its cluster RPC secret (openssl rand -hex 32);
# the admin token guards the administration API and is optional.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
